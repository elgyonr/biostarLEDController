<UserControl x:Class="LedSync.CasePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Kasa önizlemesi" AutomationProperties.HelpText="Sync kapalıyken ok tuşlarıyla parça seçilir">
  <!-- Egik izdusum (tuvaldeki SVG ile ayni): yan yuz duz; on ve ust yuz (+100, -40) ile geri cekilir.
       SVG matrix(a b c d e f) = WPF Matrix(M11=a, M12=b, M21=c, M22=d, OffsetX=e, OffsetY=f). -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="IoRing" Color="#FF0000"/>
    <SolidColorBrush x:Key="IoSoft" Color="#FF0000" Opacity="0.3"/>
    <SolidColorBrush x:Key="H1Ring" Color="#FF0000"/>
    <SolidColorBrush x:Key="H1Soft" Color="#FF0000" Opacity="0.3"/>
    <SolidColorBrush x:Key="GpuRing" Color="#FF0000"/>
    <SolidColorBrush x:Key="GpuSoft" Color="#FF0000" Opacity="0.3"/>
    <!-- Delikli sac: 9x9 karoda opak zemin, ortada saydam delik. -->
    <DrawingBrush x:Key="Perforation" TileMode="Tile" Viewport="0,0,9,9" ViewportUnits="Absolute" Viewbox="0,0,9,9" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing Brush="White">
          <GeometryDrawing.Geometry>
            <CombinedGeometry GeometryCombineMode="Exclude">
              <CombinedGeometry.Geometry1><RectangleGeometry Rect="0,0,9,9"/></CombinedGeometry.Geometry1>
              <CombinedGeometry.Geometry2><EllipseGeometry Center="4.5,4.5" RadiusX="2.6" RadiusY="2.6"/></CombinedGeometry.Geometry2>
            </CombinedGeometry>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>

  <Viewbox Stretch="Uniform" MaxHeight="520">
    <Canvas Width="420" Height="530">
      <!-- Ust yuz: u kasa boyunca 0-280, w derinlik 0-200. CPU sogutucunun iki fani. -->
      <Canvas x:Name="TopPart" Tag="cpu" MouseLeftButtonUp="OnPart">
        <Canvas.RenderTransform><MatrixTransform Matrix="1,0,0.5,-0.2,20,60"/></Canvas.RenderTransform>
        <Rectangle Width="280" Height="200" Fill="{DynamicResource CaseTop}" Stroke="{DynamicResource CaseEdge}" StrokeThickness="1.5"/>
        <Canvas>
          <Canvas.Clip><RectangleGeometry Rect="14,14,252,172"/></Canvas.Clip>
          <Rectangle Canvas.Left="14" Canvas.Top="14" Width="252" Height="172" Fill="#0d0d0d"/>
          <Ellipse Canvas.Left="18" Canvas.Top="30" Width="140" Height="140" Fill="{StaticResource H1Soft}"/>
          <Ellipse Canvas.Left="32" Canvas.Top="44" Width="112" Height="112" Stroke="{StaticResource H1Ring}" StrokeThickness="12"/>
          <Ellipse Canvas.Left="70" Canvas.Top="82" Width="36" Height="36" Fill="#151515"/>
          <Ellipse Canvas.Left="134" Canvas.Top="30" Width="140" Height="140" Fill="{StaticResource H1Soft}"/>
          <Ellipse Canvas.Left="148" Canvas.Top="44" Width="112" Height="112" Stroke="{StaticResource H1Ring}" StrokeThickness="12"/>
          <Ellipse Canvas.Left="186" Canvas.Top="82" Width="36" Height="36" Fill="#151515"/>
          <Rectangle Canvas.Left="14" Canvas.Top="14" Width="252" Height="172" Fill="#1b1b1b" Opacity="0.88" OpacityMask="{StaticResource Perforation}">
            <Rectangle.CacheMode><BitmapCache/></Rectangle.CacheMode>
          </Rectangle>
        </Canvas>
        <Rectangle x:Name="TopFrame" Canvas.Left="14" Canvas.Top="14" Width="252" Height="172" Stroke="#2c2c2c" StrokeThickness="2"/>
      </Canvas>

      <!-- Yan yuz ve cam -->
      <Rectangle Canvas.Left="20" Canvas.Top="60" Width="280" Height="460" Fill="{DynamicResource CaseSide}" Stroke="{DynamicResource CaseEdge}" StrokeThickness="1.5"/>
      <Rectangle Canvas.Left="34" Canvas.Top="76" Width="254" Height="432" Fill="#0b0b0b"/>
      <Canvas>
        <Canvas.Clip><RectangleGeometry Rect="34,76,254,432"/></Canvas.Clip>
        <Rectangle Canvas.Left="62" Canvas.Top="128" Width="210" Height="272" Fill="#141414" Stroke="#222222" StrokeThickness="1"/>
        <Rectangle Canvas.Left="52" Canvas.Top="82" Width="220" Height="18" Fill="#1e1e1e"/>
        <Path Data="M170,206 C142,206 124,188 124,100" Stroke="#262626" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M172,222 C130,224 106,200 106,100" Stroke="#262626" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse x:Name="PumpFrame" Canvas.Left="168" Canvas.Top="188" Width="52" Height="52" Fill="#1c1c1c" Stroke="#2c2c2c" StrokeThickness="2"
                 Tag="cpu" MouseLeftButtonUp="OnPart"/>
        <Ellipse Canvas.Left="172" Canvas.Top="192" Width="44" Height="44" Fill="{StaticResource H1Soft}" Tag="cpu" MouseLeftButtonUp="OnPart"/>
        <Polygon Points="186,201 202,201 209,214 202,227 186,227 179,214" Stroke="{StaticResource H1Ring}" StrokeThickness="3" StrokeLineJoin="Round"/>
        <Rectangle x:Name="GpuFrame" Canvas.Left="48" Canvas.Top="300" Width="232" Height="42" Fill="#202020" Stroke="#2a2a2a" StrokeThickness="1"
                   Tag="gpu" MouseLeftButtonUp="OnPart"/>
        <Rectangle Canvas.Left="56" Canvas.Top="333" Width="62" Height="2" Fill="#2a2a2a"/>
        <Polyline Points="128,324 234,324 248,312" Stroke="{StaticResource GpuSoft}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Tag="gpu" MouseLeftButtonUp="OnPart"/>
        <Polyline Points="128,324 234,324 248,312" Stroke="{StaticResource GpuRing}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Tag="gpu" MouseLeftButtonUp="OnPart"/>
        <Rectangle Canvas.Left="34" Canvas.Top="410" Width="254" Height="98" Fill="#111111"/>
      </Canvas>
      <Rectangle Canvas.Left="34" Canvas.Top="76" Width="254" Height="432" Stroke="#2a2a2a" StrokeThickness="1"/>

      <!-- On yuz: u 0-200, v 0-460. On fanlar. -->
      <Canvas x:Name="FrontPart" Tag="fans" MouseLeftButtonUp="OnPart">
        <Canvas.RenderTransform><MatrixTransform Matrix="0.5,-0.2,0,1,300,60"/></Canvas.RenderTransform>
        <Rectangle Width="200" Height="460" Fill="{DynamicResource CaseFront}" Stroke="{DynamicResource CaseEdge}" StrokeThickness="1.5"/>
        <Canvas>
          <Canvas.Clip><RectangleGeometry Rect="12,14,176,432"/></Canvas.Clip>
          <Rectangle Canvas.Left="12" Canvas.Top="14" Width="176" Height="432" Fill="#0d0d0d"/>
          <Ellipse Canvas.Left="30" Canvas.Top="26" Width="140" Height="140" Fill="{StaticResource IoSoft}"/>
          <Ellipse Canvas.Left="44" Canvas.Top="40" Width="112" Height="112" Stroke="{StaticResource IoRing}" StrokeThickness="12"/>
          <Ellipse Canvas.Left="82" Canvas.Top="78" Width="36" Height="36" Fill="#151515"/>
          <Ellipse Canvas.Left="30" Canvas.Top="160" Width="140" Height="140" Fill="{StaticResource IoSoft}"/>
          <Ellipse Canvas.Left="44" Canvas.Top="174" Width="112" Height="112" Stroke="{StaticResource IoRing}" StrokeThickness="12"/>
          <Ellipse Canvas.Left="82" Canvas.Top="212" Width="36" Height="36" Fill="#151515"/>
          <Ellipse Canvas.Left="30" Canvas.Top="294" Width="140" Height="140" Fill="{StaticResource IoSoft}"/>
          <Ellipse Canvas.Left="44" Canvas.Top="308" Width="112" Height="112" Stroke="{StaticResource IoRing}" StrokeThickness="12"/>
          <Ellipse Canvas.Left="82" Canvas.Top="346" Width="36" Height="36" Fill="#151515"/>
          <Rectangle Canvas.Left="12" Canvas.Top="14" Width="176" Height="432" Fill="#181818" Opacity="0.88" OpacityMask="{StaticResource Perforation}">
            <Rectangle.CacheMode><BitmapCache/></Rectangle.CacheMode>
          </Rectangle>
        </Canvas>
        <Rectangle x:Name="FrontFrame" Canvas.Left="12" Canvas.Top="14" Width="176" Height="432" Stroke="#2c2c2c" StrokeThickness="2"/>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
