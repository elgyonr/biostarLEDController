<UserControl x:Class="LedSync.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Renk seçici">
  <!-- Tek alan: yatayda renk tonu, dikeyde doygunluk (ustte tam renk, altta beyaz). Koyuluk yok:
       LED'de koyu renk yalnizca sonuk isik demek; parlakligi kaydirici belirler. -->
  <!-- Klavye: sol/sag ton, yukari/asagi doygunluk; Shift ile ince adim. -->
  <Grid x:Name="Area" Height="190" Cursor="Cross" Background="Transparent" Focusable="True"
        MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp" KeyDown="OnKey">
    <Border CornerRadius="8">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#FF0000" Offset="0"/>
          <GradientStop Color="#FFFF00" Offset="0.1667"/>
          <GradientStop Color="#00FF00" Offset="0.3333"/>
          <GradientStop Color="#00FFFF" Offset="0.5"/>
          <GradientStop Color="#0000FF" Offset="0.6667"/>
          <GradientStop Color="#FF00FF" Offset="0.8333"/>
          <GradientStop Color="#FF0000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="8">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00FFFFFF" Offset="0"/>
          <GradientStop Color="White" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Canvas IsHitTestVisible="False">
      <Ellipse x:Name="Thumb" Width="18" Height="18" Stroke="White" StrokeThickness="2.5">
        <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
      </Ellipse>
    </Canvas>
  </Grid>
</UserControl>
